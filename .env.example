# ---- REQUIRED for live mode (real Sanity Context + model) ----
# Context MCP endpoint, e.g. https://api.sanity.io/v1/context/organizations/<orgId>/mcp/<endpointName>
SANITY_CONTEXT_MCP_URL=
# ORGANIZATION-level API token with Context Viewer permission (project tokens are rejected). Server-side only.
SANITY_ORG_API_TOKEN=
# Model provider key (Anthropic Messages API). Server-side only.
ANTHROPIC_API_KEY=

# ---- OPTIONAL ----
# Restrict retrieval to one Knowledge Base id (starts with "kb")
SANITY_KNOWLEDGE_BASE_ID=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
PORT=3000
MCP_TIMEOUT_MS=15000
MODEL_TIMEOUT_MS=60000
MCP_MAX_DOCS=16
RATE_LIMIT_PER_MINUTE=12

# ---- DEVELOPMENT ONLY ----
# 1 = serve knowledge-base/sources through a local MOCK MCP server with a rule-based extractor.
# NOT Sanity. The UI shows a banner. Never enabled automatically when live retrieval fails.
BUDGETBITES_DEV_MOCK=0
